{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rungkai",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "CORPUS", "bucket_name": "rungkai-corpus" }],
  "durable_objects": {
    "bindings": [
      { "name": "BUDGET", "class_name": "Budget" },
      { "name": "RATE_LIMIT", "class_name": "RateLimit" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Budget"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimit"] }
  ],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }
  ],
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-flash",
    "DAILY_BUDGET_MICRO": "200000",
    "CORPUS_VERSION": "43",
    "EMBED_POOLING": "mean",
    "EMBED_MODEL": "@cf/qwen/qwen3-embedding-0.6b"
  }
}
