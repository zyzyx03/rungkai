{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rungkai",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "CORPUS", "bucket_name": "rungkai-corpus" }],
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "Budget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Budget"] }],
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }
  ],
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-flash",
    "DAILY_BUDGET_MICRO": "1000000",
    "CORPUS_VERSION": "21"
  }
}
