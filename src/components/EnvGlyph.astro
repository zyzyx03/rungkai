---
// Tiny monochrome distro marks for the environment picker. Silhouettes only:
// at 12px a detailed logo turns to mud.
const { name, class: className } = Astro.props;
---
{name === "ubuntu" && (
  <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="5.2" stroke="currentColor" stroke-width="1.2" />
    <circle cx="8" cy="2.3" r="1.5" fill="currentColor" />
    <circle cx="3.06" cy="10.95" r="1.5" fill="currentColor" />
    <circle cx="12.94" cy="10.95" r="1.5" fill="currentColor" />
  </svg>
)}
{name === "rocky" && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true">
    <path d="M1 13 6.4 4.4 9 8l2-2.8L15 13Z" fill="currentColor" />
  </svg>
)}
{name === "alpine" && (
  <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M2.2 12.4 8 3.6l5.8 8.8Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
  </svg>
)}
{name === "all" && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true">
    <circle cx="5" cy="5" r="1.7" fill="currentColor" />
    <circle cx="11" cy="5" r="1.7" fill="currentColor" />
    <circle cx="5" cy="11" r="1.7" fill="currentColor" />
    <circle cx="11" cy="11" r="1.7" fill="currentColor" />
  </svg>
)}
{name === "terminal" && (
  <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <rect x="1.8" y="3" width="12.4" height="10" rx="1.6" stroke="currentColor" stroke-width="1.2" />
    <path d="M4.6 6.6 6.8 8.4 4.6 10.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M8.4 10.4h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  </svg>
)}
{name === "prompt" && (
  <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M3.5 4.5 7 8l-3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M8.6 11.5H13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
  </svg>
)}
{name === "docker" && (
  <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <rect x="2" y="8.4" width="12" height="4.4" rx="1" stroke="currentColor" stroke-width="1.2" />
    <rect x="3.7" y="5.5" width="2.4" height="2" rx=".4" fill="currentColor" />
    <rect x="6.9" y="5.5" width="2.4" height="2" rx=".4" fill="currentColor" />
    <rect x="10.1" y="5.5" width="2.4" height="2" rx=".4" fill="currentColor" />
  </svg>
)}
{name === "git" && (
  <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="4" cy="3.6" r="1.5" stroke="currentColor" stroke-width="1.2" />
    <circle cx="4" cy="12.4" r="1.5" stroke="currentColor" stroke-width="1.2" />
    <circle cx="12" cy="6.2" r="1.5" stroke="currentColor" stroke-width="1.2" />
    <path d="M4 5.1v5.8M12 7.7c0 2-1.9 2.5-3.7 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  </svg>
)}
{name === "gear" && (
  <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="2.4" stroke="currentColor" stroke-width="1.2" />
    <path d="M8 1.6v1.9M8 12.5v1.9M1.6 8h1.9M12.5 8h1.9M3.5 3.5l1.3 1.3M11.2 11.2l1.3 1.3M12.5 3.5l-1.3 1.3M4.8 11.2l-1.3 1.3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  </svg>
)}
{name === "network" && (
  <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="1.6" fill="currentColor" />
    <circle cx="3" cy="3.4" r="1.3" stroke="currentColor" stroke-width="1.1" />
    <circle cx="13" cy="3.4" r="1.3" stroke="currentColor" stroke-width="1.1" />
    <circle cx="8" cy="13.6" r="1.3" stroke="currentColor" stroke-width="1.1" />
    <path d="M4.1 4.5 6.8 6.8M11.9 4.5 9.2 6.8M8 9.6v2.6" stroke="currentColor" stroke-width="1.1" />
  </svg>
)}
{name === "search" && (
  <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="7" cy="7" r="4.2" stroke="currentColor" stroke-width="1.3" />
    <path d="M10.2 10.2 14 14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
  </svg>
)}
{name === "archive" && (
  <svg class={className} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <rect x="2" y="3" width="12" height="3" rx=".8" stroke="currentColor" stroke-width="1.2" />
    <path d="M3.2 6v6.2c0 .5.4.8.8.8h8c.4 0 .8-.3.8-.8V6" stroke="currentColor" stroke-width="1.2" />
    <path d="M6.4 9h3.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  </svg>
)}
