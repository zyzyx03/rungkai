{
  "name": "rungkai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro build && wrangler dev --remote",
    "dev:local": "astro build && wrangler dev --config wrangler.local.jsonc --port 8787",
    "build": "astro build",
    "deploy": "astro build && wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "test:browser": "npm run build && node test/browser/motion.mjs",
    "ingest": "node ingest/ingest.mjs",
    "embed": "node ingest/embed.mjs",
    "test:promptfoo": "bash test/promptfoo/run.sh",
    "test:redteam": "bash test/promptfoo/run-redteam.sh",
    "test:promptfoo:all": "bash test/promptfoo/run-all.sh",
    "test:all": "npm test && npm run test:promptfoo:all",
    "eval:retrieval": "node test/retrieval/eval.mjs",
    "corpus:index": "node ingest/index.mjs",
    "corpus:prune": "node ingest/prune.mjs",
    "embed:local": "node ingest/embed-local.mjs",
    "eval:retrieval:local": "node test/retrieval/eval.mjs --local",
    "corpus:kubectl": "node ingest/kubectl-help.mjs"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "hono": "^4.13.13",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.27.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@unocss/astro": "^66.11.0",
    "unocss": "^66.11.0",
    "wrangler": "^4"
  }
}
